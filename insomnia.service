[Unit]
Description=Insomnia Discord voice bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/insomnia
EnvironmentFile=/home/ubuntu/insomnia/.env
ExecStart=/home/ubuntu/insomnia/venv/bin/python bot.py
Restart=always
RestartSec=5
MemoryMax=200M

[Install]
WantedBy=multi-user.target
